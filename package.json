{
  "name": "coin-loop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Coins modelled in Blender, minted in silver and looped live in the browser with three.js. A hands-on design engineering project.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "coins": "/Applications/Blender.app/Contents/MacOS/Blender -b -P blender/coins.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
